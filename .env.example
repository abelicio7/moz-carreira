# ID do Projeto Supabase (ex: pojhrxazqblnlnmdbbvk)
SUPABASE_PROJECT_ID="seu-project-id-aqui"
# Chave pública anónima do Supabase (Anon Key / Publishable Key)
SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
# URL do projeto Supabase (ex: https://seu-project-id.supabase.co)
SUPABASE_URL="https://seu-project-id-aqui.supabase.co"

# Variáveis expostas ao cliente Vite (iguais às anteriores)
VITE_SUPABASE_PROJECT_ID="seu-project-id-aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-key-aqui"
VITE_SUPABASE_URL="https://seu-project-id-aqui.supabase.co"

# Configurações de Inteligência Artificial (Opcional - Adicione pelo menos uma)
GEMINI_API_KEY="sua-chave-api-do-gemini-aqui"
OPENAI_API_KEY="sua-chave-api-da-openai-aqui"
